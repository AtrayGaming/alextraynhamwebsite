{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radio-ready",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "CLOUDFLARE_WORKER": "1"
  },
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "radio.alextraynham.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "radio-ready"
    }
  ]
}
