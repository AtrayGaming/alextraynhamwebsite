{
  "name": "radio-ready",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/run-verification.mjs --browser-only",
    "db:setup": "node --env-file=.env.local --import tsx scripts/setup.ts",
    "account:create": "node --env-file=.env.local --import tsx scripts/create-account.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@libsql/client": "0.18.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.53.0",
    "next": "16.4.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
